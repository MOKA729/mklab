# Anthropic API key — required
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Splunk MCP server transport. Pick ONE of the two options below.
# ---------------------------------------------------------------------------

# Option A: stdio (local Splunk MCP server launched as a subprocess)
# Example: a Splunk MCP server installed via pip / uv / npm
SPLUNK_MCP_TRANSPORT=stdio
SPLUNK_MCP_COMMAND=uvx
SPLUNK_MCP_ARGS=splunk-mcp-server

# Splunk credentials passed to the MCP subprocess (the Splunk MCP server
# reads these from its environment to authenticate against Splunk).
SPLUNK_HOST=splunk.example.com
SPLUNK_PORT=8089
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=changeme
SPLUNK_TOKEN=
SPLUNK_VERIFY_SSL=true

# Option B: SSE / HTTP (remote Splunk MCP server reachable over the network)
# SPLUNK_MCP_TRANSPORT=sse
# SPLUNK_MCP_URL=https://splunk-mcp.example.com/sse
# SPLUNK_MCP_AUTH_HEADER=Bearer your-token-here

# ---------------------------------------------------------------------------
# Prioritization run configuration
# ---------------------------------------------------------------------------

# How many findings to pull per run. Keep this bounded to avoid
# blowing the context window.
MAX_FINDINGS=50

# Splunk search to use as the findings source. Defaults to notable events
# from Enterprise Security; override for a different index/sourcetype.
SPLUNK_FINDINGS_SEARCH=search index=notable earliest=-24h | head 50
